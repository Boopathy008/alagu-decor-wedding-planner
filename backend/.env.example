# Database (Supabase Postgres connection string)
DATABASE_URL=jdbc:postgresql://<supabase-host>:5432/postgres
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your-supabase-db-password

# JWT
JWT_SECRET=replace-with-a-long-random-base64-secret-min-256-bits
JWT_EXPIRATION_MS=86400000

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Public-facing config also used by backend for CORS / links
WHATSAPP_NUMBER=919999999999
INSTAGRAM_URL=https://instagram.com/alagudecor

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# Server
PORT=8080

# Initial admin account — only used ONCE, on first boot, if the admins table
# is empty. Change this password after your first login; safe to leave these
# two lines in .env permanently since the seeder never overwrites an existing
# admin.
INITIAL_ADMIN_EMAIL=admin@alagudecor.com
INITIAL_ADMIN_PASSWORD=ChangeThisImmediately!123
